# Database Connection
DATABASE_URL=postgres://admin:admin@localhost:5432/sciconnect_db

# Payload CMS Secret
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET_KEY

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First Admin Seeder Credentials (Development / Bootstrap)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@sciconnect.world
SEED_ADMIN_PASSWORD=Password123!

# Authentication Security Settings (Optional)
AUTH_TOKEN_EXPIRATION=28800
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_TIME=600000
AUTH_VERIFY_EMAIL=false

# SMTP Email Configuration (Optional - standard console email adapter used in dev if not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=SciConnectWorld
SMTP_FROM_ADDRESS=noreply@sciconnect.world
